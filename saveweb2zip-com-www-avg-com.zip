        <ul>
          <li>Everything in Free</li>
          <li>Malware scanning integration</li>
          <li>Security reports</li>
          <li>Priority support</li>
        </ul>
        <a href="#contact" class="btn btn-primary">Choose Pro</a>
      </article>

      <article class="price-card">
        <h3>Business</h3>
        <p class="description">For teams and businesses</p>
        <div class="price">?999 <small>/ year</small></div>
        <ul>
          <li>Everything in Pro</li>
          <li>Multi-device plan option</li>
          <li>Business dashboard option</li>
          <li>Support options</li>
        </ul>
        <a href="#contact" class="btn btn-outline">Contact Us</a>
      </article>
    </div>
  </div>
</section>

<!-- FAQ -->
<section id="faq" style="background:#f8f9ff">
  <div class="container">
    <div class="section-title">
      <span class="tag">FAQ</span>
      <h2>Frequently Asked Questions</h2>
      <p>Answers about this antivirus website template.</p>
    </div>

    <div class="faq-list">
      <div class="faq-item">
        <button class="faq-question" aria-expanded="false">
          What is ShieldX? <span class="plus">+</span>
        </button>
        <div class="faq-answer">
          ShieldX is a customizable antivirus website template.
          Replace the example branding with your own.
        </div>
      </div>

      <div class="faq-item">
        <button class="faq-question" aria-expanded="false">
          Does the scanner detect real viruses? <span class="plus">+</span>
        </button>
        <div class="faq-answer">
          No. The scanner is an animation only. Real detection
          requires a genuine antivirus engine.
        </div>
      </div>

      <div class="faq-item">
        <button class="faq-question" aria-expanded="false">
          Can I change the prices? <span class="plus">+</span>
        </button>
        <div class="faq-answer">
          Yes. Edit the plan names, prices and benefits in the HTML.
          Actual payments require a secure payment provider.
        </div>
      </div>

      <div class="faq-item">
        <button class="faq-question" aria-expanded="false">
          Does it work on mobile? <span class="plus">+</span>
        </button>
        <div class="faq-answer">
          Yes. Responsive CSS adjusts the layout for phones,
          tablets and desktop screens.
        </div>
      </div>
    </div>
  </div>
</section>

<!-- CONTACT -->
<section id="contact">
  <div class="container">
    <div class="cta">
      <h2>Build A Safer Digital Future</h2>
      <p>Customize the template for your cybersecurity brand.</p>
      <a href="mailto:hello@example.com" class="btn">Contact Us ?</a>
    </div>
  </div>
</section>

</main>

<!-- FOOTER -->
<footer>
  <div class="container">
    <div class="footer-grid">
      <div>
        <h3>? Shield<span style="color:#8b83ff">X</span></h3>
        <p>A modern website template for showcasing cybersecurity products and services.</p>
      </div>

      <div>
        <h4>Quick Links</h4>
        <ul>
          <li><a href="#home">Home</a></li>
          <li><a href="#features">Features</a></li>
          <li><a href="#scanner">Scanner</a></li>
          <li><a href="#pricing">Pricing</a></li>
        </ul>
      </div>

      <div>
        <h4>Information</h4>
        <ul>
          <li><a href="#faq">FAQ</a></li>
          <li><a href="#contact">Contact</a></li>
          <li><a href="#contact">Privacy Policy</a></li>
          <li><a href="#contact">Terms of Service</a></li>
        </ul>
      </div>
    </div>

    <div class="copyright">
      © <span id="year"></span> ShieldX. All rights reserved.
    </div>
  </div>
</footer>

<script>
// Mobile navigation
const menuToggle = document.getElementById("menuToggle");
const navLinks = document.getElementById("navLinks");

menuToggle.addEventListener("click", () => {
  const open = navLinks.classList.toggle("active");
  menuToggle.setAttribute("aria-expanded", String(open));
  menuToggle.textContent = open ? "?" : "?";
});

navLinks.querySelectorAll("a").forEach(link => {
  link.addEventListener("click", () => {
    navLinks.classList.remove("active");
    menuToggle.setAttribute("aria-expanded", "false");
    menuToggle.textContent = "?";
  });
});

// FAQ accordion
document.querySelectorAll(".faq-question").forEach(button => {
  button.addEventListener("click", () => {
    const item = button.closest(".faq-item");
    const open = item.classList.toggle("open");
    button.setAttribute("aria-expanded", String(open));
  });
});

// Simulated scanner: no real files are accessed.
const scanButton = document.getElementById("scanButton");
const progressBar = document.getElementById("progressBar");
const progressText = document.getElementById("progressText");
const filesText = document.getElementById("filesText");
const scanStatus = document.getElementById("scanStatus");
const scanResult = document.getElementById("scanResult");

let scanning = false;

scanButton.addEventListener("click", () => {
  if (scanning) return;

  scanning = true;
  let progress = 0;

  scanButton.disabled = true;
  scanButton.textContent = "Scanning demo...";
  scanResult.style.display = "none";
  scanStatus.textContent = "Running simulated demonstration";

  progressBar.style.width = "0%";
  progressText.textContent = "0% complete";
  filesText.textContent = "0 demo items checked";

  const timer = setInterval(() => {
    progress = Math.min(progress + Math.floor(Math.random() * 12) + 5, 100);

    progressBar.style.width = progress + "%";
    progressText.textContent = progress + "% complete";
    filesText.textContent = Math.floor(progress * 12.5) + " simulated items";

    if (progress >= 100) {
      clearInterval(timer);
      scanning = false;

      scanStatus.textContent = "Demonstration completed";
      scanResult.textContent =
        "Demo complete! No actual files were accessed or scanned for malware.";
      scanResult.style.display = "block";

      scanButton.disabled = false;
      scanButton.textContent = "? Run Demo Again";
    }
  }, 350);
});

// Automatic copyright year
document.getElementById("year").textContent = new Date().getFullYear();
</script>

</body>
</html>
```
